generator client {
  provider = "prisma-client-js"
}

// MySQL/MariaDB, bukan PostgreSQL seperti rencana awal — environment deploy yang
// tersedia (cPanel shared hosting kampus) hanya menyediakan MariaDB, tidak ada
// PostgreSQL/Docker. Skema tabel tidak berubah, hanya provider datasource-nya.
datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Admin {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  kegiatan Kegiatan[]
}

model Kegiatan {
  id            String   @id @default(uuid())
  slug          String   @unique
  nama          String
  deskripsi     String?  @db.Text
  lokasi        String
  waktuMulai    DateTime
  waktuSelesai  DateTime
  ditutupManual Boolean  @default(false)
  createdById   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  createdBy  Admin        @relation(fields: [createdById], references: [id])
  kehadiran  Kehadiran[]
  pertanyaan Pertanyaan[]

  @@index([waktuMulai, waktuSelesai])
}

// Pertanyaan kuisioner singkat yang ditentukan admin per-kegiatan, ditampilkan
// setelah peserta konfirmasi NIM dan wajib diisi sebelum kehadiran tercatat.
model Pertanyaan {
  id         String   @id @default(uuid())
  kegiatanId String
  teks       String
  urutan     Int      @default(0)
  createdAt  DateTime @default(now())

  kegiatan Kegiatan            @relation(fields: [kegiatanId], references: [id], onDelete: Cascade)
  jawaban  JawabanKuisioner[]

  @@index([kegiatanId])
}

model Kehadiran {
  id                    String   @id @default(uuid())
  kegiatanId            String
  nim                   String
  nama                  String
  programStudi          String
  programStudiSevimaId  String?
  waktuKonfirmasi       DateTime @default(now())
  ipAddress             String?
  userAgent             String?  @db.Text

  kegiatan Kegiatan           @relation(fields: [kegiatanId], references: [id], onDelete: Cascade)
  jawaban  JawabanKuisioner[]

  @@unique([kegiatanId, nim])
  @@index([kegiatanId])
  @@index([nim])
}

// Jawaban peserta untuk satu pertanyaan kuisioner, dicatat bersamaan dengan Kehadiran.
model JawabanKuisioner {
  id           String @id @default(uuid())
  kehadiranId  String
  pertanyaanId String
  jawaban      String @db.Text

  kehadiran  Kehadiran  @relation(fields: [kehadiranId], references: [id], onDelete: Cascade)
  pertanyaan Pertanyaan @relation(fields: [pertanyaanId], references: [id], onDelete: Cascade)

  @@unique([kehadiranId, pertanyaanId])
  @@index([pertanyaanId])
}
