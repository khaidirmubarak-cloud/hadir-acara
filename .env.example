# URL publik aplikasi (dipakai untuk generate link/QR kegiatan)
APP_URL="http://localhost:3000"

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/daftar_hadir?schema=public"

# Sesi admin (JWT)
SESSION_SECRET="CHANGE_ME_generate_with_openssl_rand_-base64_48"
SESSION_DURATION_HOURS=12

# Dipakai sekali oleh `npm run seed` untuk membuat akun admin pertama
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Sevima Platform API — TODO: isi sebelum go-live, JANGAN commit nilai asli.
# Catatan: "siakadcloud.sevima.com" (dipakai di beberapa .env.example proyek kampus lain)
# TIDAK punya DNS record publik (terverifikasi saat implementasi — ENOTFOUND). Base URL
# yang benar & terbukti reachable adalah api.sevimaplatform.com — juga wajib IP whitelist,
# lihat catatan di README/plan soal cara menambahkan IP server ini ke whitelist Sevima.
SEVIMA_BASE_URL=https://api.sevimaplatform.com
SEVIMA_APP_KEY=TODO_ISI_APP_KEY
SEVIMA_SECRET_KEY=TODO_ISI_SECRET_KEY
SEVIMA_TIMEOUT_MS=8000

NODE_ENV=development
